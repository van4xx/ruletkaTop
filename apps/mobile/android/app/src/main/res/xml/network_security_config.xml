<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for ruletka.top mobile.

  Cleartext (plain HTTP/WS) traffic is DENIED by default on every build type —
  this removes the previous blanket `android:usesCleartextTraffic="true"`, which
  let an attacker on a hostile network HTTP-downgrade and MITM the API/token
  traffic. Production talks to `https://api.ruletka.top` (injected via
  `--dart-define=API_BASE_URL`/`WS_URL`, see lib/core/api/api_config.dart), so
  no cleartext is needed in release builds.

  The ONLY cleartext exception is the developer loopback used by the dev
  `ApiConfig` defaults (Android emulator → 10.0.2.2, host loopback → localhost).
  These addresses are not routable off-device, so the exception can never be
  abused by a network attacker against the production API.
-->
<network-security-config>
    <!-- Default: forbid cleartext for all destinations (prod API is HTTPS). -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- DEV ONLY: permit cleartext to the local backend on the developer's
         machine. 10.0.2.2 is the Android-emulator alias for the host loopback;
         localhost / 127.0.0.1 / ::1 cover simulator/desktop and on-device dev. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
