# ──────────────────────────── Core ────────────────────────────
NODE_ENV=development

# ─────────────────────────── API (NestJS) ──────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
# Parent domain for the auth cookies (refresh + presence marker). Leave BLANK in
# dev (localhost is single-origin, so the cookies stay host-only). In prod set to
# the shared registrable domain — e.g. `.ruletka.top` — so the cookies are shared
# across `ruletka.top` + `api.ruletka.top` (edge middleware on the apex can read
# the server-set presence marker; the refresh cookie rides the cross-subdomain
# credentialed refresh).
COOKIE_DOMAIN=

# ──────────────── User uploads (avatars, local disk) ───────────
# Directory the API writes user-uploaded avatar images to (subfolder `avatars/`).
# DEV: leave blank → defaults to `<apps/api>/uploads`, served by the Node process
# at `/uploads/**` (see apps/api/src/main.ts). An absolute path is used verbatim;
# a relative one resolves against the API process cwd.
# PROD: set to a path backed by a PERSISTENT Docker volume (the container FS is
# ephemeral — avatars would be lost on redeploy) and serve `/uploads/**` from that
# volume directly via nginx (bypassing Node). e.g. UPLOADS_DIR=/var/lib/ruletka/uploads
UPLOADS_DIR=
# Externally-reachable base origin the avatar files are served from, used to turn
# the stored relative `/uploads/...` path into an absolute URL on profile reads so
# a cross-origin client (web app on :3000, mobile) can load it. DEV: set to the
# API origin, e.g. http://localhost:4000. PROD: the origin that serves `/uploads`
# (commonly the same apex as the web app when nginx co-serves them, e.g.
# https://ruletka.top — in which case avatars are same-origin and this can stay
# blank). Blank → the stored relative path is returned unchanged (same-origin).
PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────── MongoDB ───────────────────────────
# Dev Mongo (docker-compose) runs as a single-node REPLICA SET (rs0) so retryable
# writes AND multi-document transactions work — parity with production. The dev
# bring-up inits rs0 automatically. Connect with ?directConnection=true — a direct
# connection to the single RS node (avoids advertised-host topology-discovery
# flakiness over the mapped port) while still enabling transactions + retryable writes.
#
# DEV: NO auth (single local node, no published-to-internet surface). PROD is
# different: infra/docker/docker-compose.prod.yml runs the 3-node RS with
# `--auth --keyFile`, and bootstrap.sh builds a CREDENTIALED MONGODB_URI of the
# shape `mongodb://app:<pw>@mongo1,mongo2,mongo3/ruletka?replicaSet=rs0&authSource=ruletka`
# (the API connects as a least-privilege `app` user scoped to the ruletka db).
# See infra/deploy/ENV_CHECKLIST.md → "Mongo / Redis" for the prod auth secrets.
MONGODB_URI=mongodb://localhost:27017/ruletka?directConnection=true&retryWrites=false

# In production, autoIndex is OFF (index builds never run silently on the hot path).
# Set RUN_INDEX_SYNC=true for a one-off boot to reconcile indexes EXPLICITLY
# (creates missing, promotes changed ones e.g. Payment.transactionId -> unique). It
# aborts boot LOUDLY on an index conflict / duplicate-data build error — resolve
# duplicates first (see LAUNCH-CHECKLIST.md §3). Leave blank/false for normal boots.
# RUN_INDEX_SYNC=false

# ─────────────────────────── Redis ─────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────── Presence ──────────────────────────
# TTL (seconds) of a user's Redis presence/online marker. The client refreshes
# it on a heartbeat; if no refresh arrives within this window the user is
# considered offline. Keep comfortably above the client heartbeat interval so a
# single missed beat does not flap the user offline. (default: 60)
PRESENCE_TTL_SECONDS=60

# ─────────────────────────── Auth / JWT ────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# ──────────────────── Transactional email (SMTP / nodemailer) ──────
# Powers account email VERIFICATION and PASSWORD RESET. ALL BLANK in dev → the
# Mailer is a clean NO-OP: every "send" is serialised + logged (at debug) and
# NO socket is opened, so dev/CI stay green and registration never fails on a
# mail outage. Set SMTP_HOST (+ the rest) to switch real delivery on.
#
# Host of the SMTP submission server (e.g. mail.ruletka.top). UNSET → no-op.
SMTP_HOST=
# Submission port. 587 ⇒ STARTTLS (default); 465 ⇒ implicit TLS. (default: 587)
SMTP_PORT=587
# SMTP auth. Leave SMTP_USER blank for an unauthenticated relay (e.g. a local
# postfix on the same box). When set, nodemailer negotiates PLAIN/LOGIN.
SMTP_USER=
SMTP_PASS=
# The `From:` header on every message. (default: "Рулетка <no-reply@<web-host>>")
MAIL_FROM=
# Public web-app base URL the emailed action links point at — the verify/reset
# PAGES live on the web app, not the API. The Mailer builds
# `${WEB_BASE_URL}/verify-email?token=…` and `${WEB_BASE_URL}/reset-password?token=…`.
# (default: https://ruletka.top)
WEB_BASE_URL=https://ruletka.top

# ──────────────────── CAPTCHA (Cloudflare Turnstile) ────────────────
# Server-side secret key for Turnstile siteverify. LEAVE BLANK in dev: when
# unset, CAPTCHA verification is a NO-OP (registration accepts any/absent
# `captchaToken`). Set it to enforce the human-challenge on POST /auth/register.
# Pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY (the public widget key, in the Web
# section below). Get both keys from the Cloudflare dashboard → Turnstile.
#
# ⚠️ REQUIRED IN PRODUCTION. It is a CRITICAL_SECRET
# (apps/api/src/common/config-validation.ts): with NODE_ENV=production the API
# FAILS-FAST at boot if this is blank/placeholder, because a no-op CAPTCHA there
# leaves /auth/register open to bot farming. `infra/deploy/bootstrap.sh` REQUIRES
# the operator to supply it. (Blank is fine ONLY because this template is dev.)
TURNSTILE_SECRET=

# ──────────────────── Anti-abuse (device fingerprint ban) ───────────
# Gate for the IP+User-Agent fingerprint ban check on register/login. OFF by
# default: the fingerprint is coarse and false-positives badly behind shared
# egress (CGNAT, corporate/VPN exit IPs), where one banned user would lock out
# everyone on that IP. `User.isBanned` remains the authoritative per-account
# gate regardless. Set to exactly `true` to re-enable the fingerprint gate.
# (default: false)
FINGERPRINT_BAN_ENABLED=false

# ─────────────────────── WebRTC / TURN (coturn) ────────────────
TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=ruletka.top
TURN_STATIC_AUTH_SECRET=change-me-turn-secret
# Lifetime (seconds) of an ephemeral TURN credential. Kept short so a leaked
# credential self-expires quickly; the client fetches a fresh one per call, so a
# 20-min window comfortably covers ICE gathering + call setup. (default: 1200)
TURN_CRED_TTL_SECONDS=1200

# ─────────────────────────── Payments ──────────────────────────
# Selects the active payment provider used by /payments checkout endpoints +
# the admin refund + the users/moderation account-teardown upstream cancel.
# Default is `tbank` (T-Bank / Tinkoff e-acquiring); `cloudpayments` keeps the
# legacy CloudPayments adapter alive as a fallback.
PAYMENT_PROVIDER=tbank

# ─── T-Bank (Tinkoff) e-acquiring — Universal connection ────────
# Read from the merchant cabinet → Terminals → Universal API / E-acquiring.
# TerminalKey + Password come together; both are required for any outbound call
# and for verifying inbound webhooks (Token is SHA-256 over the signed fields +
# Password). Leave BLANK to fall back to the legacy CloudPayments provider
# (PAYMENT_PROVIDER=cloudpayments). NEVER commit real credentials.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Base URL. Prod + DEMO use the SAME URL — DEMO is selected by a DEMO-suffixed
# TerminalKey, not a different host. (default: https://securepay.tinkoff.ru/v2/)
TBANK_API_URL=https://securepay.tinkoff.ru/v2/
# Set to `true` when using a DEMO/test terminal (terminal id ends with DEMO).
# Currently informational only — the API URL is shared with prod.
TBANK_IS_TEST=false
# Public URLs T-Bank redirects the browser to after the hosted-checkout flow.
# Both should land on a page that re-fetches the user's entitlement (coins
# balance / premium status) — entitlement itself is granted by the webhook.
TBANK_SUCCESS_URL=https://ruletka.top/wallet?payment=ok
TBANK_FAIL_URL=https://ruletka.top/wallet?payment=fail
# Optional override of where T-Bank should POST webhooks. Blank → omitted in
# the Init body (T-Bank uses the NotificationURL configured in the cabinet,
# which is the recommended setup). Set ONLY when you need to override per
# environment (e.g. ngrok in dev).
TBANK_NOTIFICATION_URL=
# Comma-separated T-Bank notification source IPs (allow-list). Get from the
# merchant cabinet → Notifications. Empty → no IP filter (Token verification
# remains the primary authenticity control).
TBANK_WEBHOOK_IPS=

# ─── Legacy CloudPayments (fallback when PAYMENT_PROVIDER=cloudpayments) ──
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Comma-separated CloudPayments notification source IPs (allowlist)
CLOUDPAYMENTS_WEBHOOK_IPS=
# Base URL for the OUTBOUND CloudPayments REST API (charge/cancel/refund). Leave
# blank to use the default (https://api.cloudpayments.ru). Override only for a
# sandbox/mock endpoint in tests. (default: https://api.cloudpayments.ru)
CLOUDPAYMENTS_API_BASE=

# ──────────────────── AI moderation (frame screening) ──────────
# Selects the SERVER-SIDE frame classifier (spot-check on reported evidence).
# Unset / 'noop' → no server classification (trusts the on-device report; this
# is the keyless default). 'provider' → the Sightengine-backed scorer, which is
# itself a no-op until BOTH credentials below are set.
FRAME_SCORER=noop
# Sightengine (https://sightengine.com) credentials for ProviderFrameScorer.
# api_secret reuses MODERATION_PROVIDER_API_KEY; api_user is its own var. Either
# blank → ProviderFrameScorer behaves as the no-op (safe/0). The integration is
# FAIL-OPEN: a provider outage logs + returns safe/0, never blocking a call.
MODERATION_PROVIDER_API_KEY=
SIGHTENGINE_API_USER=
# Optional tunables (sensible defaults baked in):
#   SIGHTENGINE_MODELS   — comma-separated model list (default nudity-2.1,gore-2.0)
#   SIGHTENGINE_MIN_PROB — below this probability a frame is treated as safe/0
#                          (0..1, default 0.5)
SIGHTENGINE_MODELS=nudity-2.1,gore-2.0
SIGHTENGINE_MIN_PROB=0.5

# ──────────────── Notifications / Push (server, NestJS) ─────────
# Web Push (browser) via the `web-push` library + VAPID. ALL THREE blank in dev →
# Web Push is a clean NO-OP (notifications still persist + deliver in-app over the
# socket; only the browser push fan-out is skipped). Set the keypair to enable it.
# Generate a pair with `npx web-push generate-vapid-keys`; the PUBLIC half also
# goes to the web app as NEXT_PUBLIC_VAPID_PUBLIC_KEY (below).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID contact subject — a mailto: or https: URI. (default: mailto:admin@ruletka.top)
VAPID_SUBJECT=
# Mobile push (FCM HTTP v1 — FCM on Android, APNs-via-FCM on iOS). Blank → mobile
# push is a clean NO-OP (notifications still persist + deliver in-app over the
# socket; only the native fan-out is skipped) and the API WARNs once at boot.
# Set it to a Firebase service-account JSON to enable real push: paste either the
# RAW JSON or its base64 encoding (single-line base64 is easiest for an env var).
# Get it from the Firebase console → Project settings → Service accounts →
# "Generate new private key". The account's project_id selects the FCM project.
FIREBASE_SERVICE_ACCOUNT=

# ────────────────────── Web (Next.js public envs) ──────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=
NEXT_PUBLIC_STUN_URLS=stun:localhost:3478
NEXT_PUBLIC_TURN_URLS=turn:localhost:3478

# ───────────── Product analytics (Plausible — privacy-first, cookieless) ─────────
# BLANK in dev → analytics is a clean NO-OP: no script is loaded, no network
# traffic, and (because Plausible is cookieless + stores no PII) NO consent banner
# is needed. Set NEXT_PUBLIC_ANALYTICS_DOMAIN to your Plausible site domain (e.g.
# ruletka.top) to turn it on. Self-hosted: point NEXT_PUBLIC_ANALYTICS_HOST at your
# instance (default https://plausible.io). The prod CSP auto-allows the host in
# script-src + connect-src when the domain is set.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_HOST=
# Cloudflare Turnstile PUBLIC site key (renders the widget on the register form,
# read at BUILD TIME by apps/web/src/components/auth/turnstile-widget.tsx). Pair
# with TURNSTILE_SECRET (Auth section) — they come from the same Cloudflare
# widget (Cloudflare dash → Turnstile → Add widget → Site key + Secret key).
#
# DEV (blank): widget skipped, API CAPTCHA also no-op (provided TURNSTILE_SECRET
# is blank too) — clean dev no-op for either local/CI.
#
# ⚠️ REQUIRED IN PRODUCTION. Without this key the register form posts no
# captcha token; the API (whose TURNSTILE_SECRET is mandatory in prod and
# enforces verification) then 400-rejects every signup with
# "CAPTCHA verification failed" → registration is effectively closed.
# `infra/deploy/bootstrap.sh` REQUIRES it alongside TURNSTILE_SECRET and bakes
# it into the web build via the docker-compose build-arg.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push VAPID PUBLIC key (base64url). Used by the browser to subscribe to
# push. Blank in dev → the "Push в этом браузере" toggle in Settings →
# Notifications hides itself and nothing touches the network (clean no-op). Must
# be the public half of the server's VAPID keypair (the API holds the private
# key + subject; that's the backend's WEB_PUSH_* / VAPID_* env). Generate a pair
# with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────── Observability — Sentry (apps/web) ─────────────────
# ALL OPTIONAL. With NEXT_PUBLIC_SENTRY_DSN blank, the browser + server + edge
# Sentry SDKs NEVER initialize (clean no-op: zero network, zero overhead) and the
# hardened CSP is left byte-for-byte unchanged. `next build` succeeds with all of
# these blank. Set the DSN to turn error tracking on.
#
# Public DSN (browser + server use it). Get it from Sentry → Project → Settings →
# Client Keys (DSN). When set, the web app's prod CSP `connect-src` auto-allows
# the DSN's ingest host.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: override the reported environment / release (else Sentry infers).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
# Optional: client traces sample rate 0..1 (default 0.1 prod / 1.0 dev).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Optional: 'true' enables Session Replay for errored sessions (off by default).
NEXT_PUBLIC_SENTRY_ENABLE_REPLAY=
# Optional: same-origin tunnel path (e.g. /monitoring) to dodge ad-blockers.
NEXT_PUBLIC_SENTRY_TUNNEL_ROUTE=
#
# SOURCE-MAP UPLOAD (build-time only; set in CI/CD for the prod build). With
# SENTRY_AUTH_TOKEN blank, source-map upload is fully disabled and the build does
# NOT fail — so local/CI builds without it stay green. Provide all three to upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional server-side overrides (fall back to the NEXT_PUBLIC_* values above).
# Set SENTRY_DSN only if the server should report to a different DSN than the browser.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# ───────────── Observability — Sentry + Prometheus (apps/api) ──────────
# ALL OPTIONAL. The API's Sentry init (apps/api/src/instrument.ts) is a clean
# NO-OP unless SENTRY_DSN (the same var above) is set: no init, no SentryModule,
# zero overhead — `nest build` / `pnpm test` stay green with everything blank.
# The /metrics endpoint is ALWAYS on regardless (it's cheap), guarded only when
# METRICS_TOKEN is set.
#
# SHARED with the block above (the API reads these directly): SENTRY_DSN,
# SENTRY_RELEASE, SENTRY_TRACES_SAMPLE_RATE (default 0.1). Point SENTRY_DSN at
# your *backend* Sentry project to turn API error tracking + tracing on.
#
# Environment label for API events. The API accepts EITHER name; SENTRY_ENV wins,
# else it falls back to SENTRY_ENVIRONMENT above, else NODE_ENV. Leave blank to
# inherit NODE_ENV.
SENTRY_ENV=
# Optional CPU profiling sample rate 0..1 (default 0.1). Only takes effect if the
# optional @sentry/profiling-node dep is installed (it's in optionalDependencies);
# absent → tracing still works, profiling is simply skipped.
SENTRY_PROFILES_SAMPLE_RATE=
#
# Prometheus scrape endpoint: GET /api/metrics (under the API global prefix,
# like /api/health). Exposes default Node/process metrics + custom gauges/counters
# (active sockets, matchmaking queue depth per type, matches created, notifications
# sent). In dev, OPEN when blank (scrape it from a private network / sidecar). Set
# METRICS_TOKEN to require `Authorization: Bearer <token>` on the endpoint.
#
# ⚠️ REQUIRED IN PRODUCTION. The MetricsTokenGuard
# (apps/api/src/observability/metrics-token.guard.ts) FAILS-FAST at boot when
# NODE_ENV=production and this is blank, because /api/metrics is reachable through
# the public nginx edge and a blank token would publish internal telemetry
# unauthenticated. `infra/deploy/bootstrap.sh` AUTO-GENERATES one (`openssl rand
# -hex 32`). (Blank is fine ONLY because this template is dev.)
METRICS_TOKEN=
