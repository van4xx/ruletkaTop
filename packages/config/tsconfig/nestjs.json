{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS 11",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "isolatedModules": false,
    "outDir": "./dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  }
}
