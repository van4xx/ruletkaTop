# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Test / coverage
coverage/

# User uploads written at runtime (dev local-disk avatar storage). The dir is
# (re)created on demand by the API; never commit uploaded images.
apps/api/uploads/
uploads/

# Env & secrets
.env
.env.local
.env.*.local
# Generated Mongo replica-set keyFile + any other on-host deploy secrets
# (bootstrap.sh writes infra/secrets/mongo-keyfile — NEVER commit it).
infra/secrets/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Flutter / Dart (apps/mobile)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Pods/
**/android/.gradle/

# Local QA screenshots & Playwright MCP artifacts
.screenshots/
.playwright-mcp/

# Claude Code local session state + agent worktrees
.claude/
