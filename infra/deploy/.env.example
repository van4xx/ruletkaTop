# =============================================================================
# infra/deploy/.env.example — operator-facing OBSERVABILITY / ALERTING vars
# -----------------------------------------------------------------------------
# This file is a TARGETED extract of the variables the Telegram-alerting
# pipeline (apps/api/src/observability/alerting/* + the nginx-watchdog
# sidecar in infra/docker/docker-compose.prod.yml) reads at deploy time.
# Copy the relevant lines into /opt/ruletka/.env on the box; the full
# operator env-checklist lives in infra/deploy/ENV_CHECKLIST.md.
#
# All values are OPTIONAL — both surfaces (API + nginx watchdog) degrade
# gracefully when the secrets are blank (no Telegram POST, no crash).
# =============================================================================

# ─────────── Telegram alerting (FATAL log + 5xx burst → operator chat) ─────────
# RECOMMENDED — free, takes 5 minutes — see SECRETS-INSTALL.md §11
# Bot token from @BotFather. The API-side AlertingService also accepts the
# older `TELEGRAM_ALERT_BOT_TOKEN` name used by the cert-watch sidecar — set
# whichever you already populate; both reach the same code path.
TELEGRAM_BOT_TOKEN=
# Target chat for alert messages. Numeric id (-100…) for a channel, or @name
# for a public username. The cert-watch sidecar uses the SAME var name; that's
# intentional — one chat, one log of operator-grade incidents.
TELEGRAM_ALERT_CHAT_ID=

# ─────────── nginx-watchdog (sidecar) thresholds ────────────────────────────
# Number of `5xx` access-log rows inside NGINX_WINDOW_SECONDS that triggers
# the "🚨 nginx 5xx burst" Telegram alert. Pick a value the LOAD profile
# justifies: at 100 req/s a healthy error rate of 0.5% would produce 30 5xx
# in 60s, so 20 events / 60s would alert; raise to 50 for a noisier baseline.
NGINX_5XX_THRESHOLD=20
# Sliding-window size in seconds. The watchdog maintains a tmp file of
# (timestamp, path) rows for in-window events and drops older ones each tick.
NGINX_WINDOW_SECONDS=60
# Minimum gap (seconds) between two consecutive Telegram POSTs from the
# watchdog. Default matches the window: at most one alert per window so a
# sustained outage paginates the operator at a steady cadence rather than
# spamming every event.
NGINX_THROTTLE_SECONDS=60

# ─────────── KYC age-verification (port + 2 providers) ──────────────────────
# The API ships a PROVIDER PORT for age verification (SumSub + Veriff stubs,
# plus a `noop` fallback). Two operator-facing toggles live here; the actual
# secrets for the chosen provider come next.
#
#   KYC_PROVIDER=sumsub|veriff|noop  (default noop → onboarding keeps working)
#   KYC_REQUIRED=true|false          (matchmaking gate; default false = OFF)
#
# With KYC_REQUIRED=false the gate is OFF and no user is affected by this
# change — the tile in /settings#account is informational only. Flip it to
# `true` only once a real provider is wired and tested end-to-end.
KYC_PROVIDER=noop
KYC_REQUIRED=false

# DEFERRED — see SECRETS-INSTALL.md "Deferred features (post-monetization)"
# -----------------------------------------------------------------------
# KYC_PROVIDER=noop above keeps the gate OFF — these credentials are only
# needed once the operator switches to a paid provider (~€1/verification).
# To enable: set KYC_PROVIDER=sumsub (or veriff), uncomment + fill the
# matching block below, then flip KYC_REQUIRED=true to enforce the gate.

# SumSub credentials (api.sumsub.com). Get them from the SumSub dashboard:
#   App Token →  Integrations → API Keys → "Token"
#   Secret Key → Integrations → API Keys → "Secret Key"
# Both are required to switch off the noop fallback when KYC_PROVIDER=sumsub.
# DEFERRED — see SECRETS-INSTALL.md "Deferred features (post-monetization)"
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=

# Veriff credentials (stationapi.veriff.com). Get them from Veriff Station:
#   API key (X-AUTH-CLIENT) → Integrations → API keys
#   Private key (HMAC secret) → Integrations → API keys → "Shared secret key"
# Both are required to switch off the noop fallback when KYC_PROVIDER=veriff.
# DEFERRED — see SECRETS-INSTALL.md "Deferred features (post-monetization)"
# VERIFF_API_KEY=
# VERIFF_PRIVATE_KEY=
